<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="repository.hbomax" name="HBO Max Repository" version="1.0.0" provider-name="HBO Max Skin">
        <requires>
            <import addon="xbmc.addon" version="12.0.0"/>
        </requires>
        <extension point="xbmc.addon.repository" name="HBO Max Repository">
            <info compressed="false">https://raw.githubusercontent.com/ffern53/hbokodirepo/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/ffern53/hbokodirepo/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/ffern53/hbokodirepo/main/zips/</datadir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary>Repository for HBO Max Skin</summary>
            <description>Install and update the HBO Max skin for Kodi. Features dynamic fanart, TMDB integration, and purple theming.</description>
            <disclaimer></disclaimer>
            <platform>all</platform>
        </extension>
    </addon>
    <addon id="skin.hbomax" version="1.0.0" name="HBO Max" provider-name="Your Name">
        <requires>
            <import addon="xbmc.gui" version="5.15.0"/>
            <import addon="plugin.video.themoviedb.helper" version="0.0.1" optional="true"/>
            <import addon="script.skinshortcuts" version="0.4.0" optional="true"/>
            <import addon="script.embuary.helper" version="1.2.14" optional="true"/>
        </requires>
        <extension point="xbmc.gui.skin" debugging="false">
            <res width="1920" height="1080" aspect="16:9" default="true" folder="1080i" />
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_US">HBO Max skin for Kodi</summary>
            <description lang="en_US">A beautiful HBO Max inspired skin for Kodi featuring the signature purple color scheme and modern interface design. Uses dynamic fanart from TMDB/your video addons.</description>
            <platform>all</platform>
            <license>GPL-2.0-or-later</license>
        </extension>
    </addon>
</addons>
